generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SourceProvider {
  STRIPE
  GITHUB
  SHOPIFY
  SLACK
  TWILIO
  GENERIC
}

enum EventStatus {
  RECEIVED // Ingested at the proxy boundary
  PROCESSING // Being routed / validated
  DELIVERED // At least one delivery succeeded
  FAILED // All delivery attempts exhausted
  DEAD_LETTER // Needs manual review / replay
}

enum DeliveryStatus {
  PENDING // Queued, not yet attempted
  SUCCESS // Destination responded 2xx
  FAILED // Non-2xx or network error
  RETRYING // Scheduled for another attempt
}

/// Machine-readable error codes for retry logic and alerting dashboards.
/// Replaces the previous unstructured internalStatus String.
enum DeliveryErrorCode {
  SIGNATURE_INVALID
  RATE_LIMITED
  DESTINATION_UNREACHABLE
  TIMEOUT
  PAYLOAD_TOO_LARGE
  PROCESSING_ERROR
}

/// Bounded set of log levels — prevents unbounded string values on EventLog.
enum LogStatus {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum LogType {
  EVENT_RECEIVED
  SIGNATURE_VERIFIED
  DELIVERY_ATTEMPT
  DELIVERY_SUCCESS
  DELIVERY_FAILED
  RETRY_SCHEDULED
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum VerificationMode {
  NONE
  OPTIONAL
  STRICT
}

// ─── Identity ─────────────────────────────────────────────────────────────────

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  /// Argon2id hash — required for all users. API keys live on Endpoint, not here.
  passwordHash String @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at")

  projects      Project[]
  subscription  Subscription?
  refreshTokens RefreshToken[]

  @@map("users")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

/// Persisted refresh tokens — enables server-side revocation and theft detection.
/// Raw token is never stored; only its SHA-256 hash is persisted.
model RefreshToken {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the raw opaque token — O(1) lookup without exposing the secret.
  tokenHash String @unique @map("token_hash")

  /// All tokens issued from the same login share a family ID.
  /// If a revoked token is re-presented, invalidate the entire family (theft detection).
  family String

  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  /// Null means valid. Set on explicit logout or theft detection.
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Soft delete — rows are hidden from queries, not physically removed.
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  endpoints   Endpoint[]

  @@index([userId])
  @@map("projects")
}

// ─── Endpoints ────────────────────────────────────────────────────────────────

model Endpoint {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name String

  tokenHash String @unique @map("token_hash")

  source SourceProvider

  destinationUrl String @map("destination_url")

  verificationMode VerificationMode @default(NONE) @map("verification_mode")

  signingSecret   String? @map("signing_secret")
  signatureHeader String? @map("signature_header")
  signatureType   String? @map("signature_type")
  timestampHeader String? @map("timestamp_header")
  toleranceSec    Int?    @map("tolerance_sec")

  eventFilters Json? @map("event_filters")

  status String @default("active")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  events WebhookEvent[]

  @@index([projectId])
  @@map("endpoints")
}

// ─── Events ───────────────────────────────────────────────────────────────────

model WebhookEvent {
  id         String   @id @default(uuid())
  endpointId String   @map("endpoint_id")
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  /// Provider's own event ID — required, not optional.
  /// Enforced unique per endpoint to prevent duplicate processing.
  eventId String @map("event_id")

  source SourceProvider

  /// Extracted from headers for direct filtering without a JSON scan.
  /// e.g. "payment_intent.succeeded", "push", "orders/create"
  eventType String? @map("event_type")

  /// Extracted provider signature header (e.g. Stripe-Signature value).
  /// Stored for re-verification and audit — keeps headers Json out of queries.
  signature Json?

  /// S3 URL to the full raw payload — keeps this table lean.
  payloadUrl String @map("payload_url")

  status   EventStatus @default(RECEIVED)
  sourceIp String?     @map("source_ip")

  /// Soft delete — physical removal deferred to retention job.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // 
  lastStatusCode Int?    @map("last_status_code")
  lastError      String? @map("last_error")

  /// Optimistic locking counter — increment on every status transition.
  /// App layer: UPDATE ... SET status=X, version=N+1 WHERE id=Y AND version=N
  version Int @default(0)

  deliveries Delivery[]
  logs       EventLog[]

  /// Composite uniqueness: same provider cannot replay same event ID to same endpoint.
  @@unique([endpointId, eventId])
  /// Hot query: latest N events for an endpoint dashboard
  @@index([endpointId, createdAt(sort: Desc)])
  /// Hot query: all failed events in a time window
  @@index([status, createdAt])
  /// Filtering by provider + event type (e.g. Stripe payment events only)
  @@index([source, eventType])
  @@map("webhook_events")
}

// ─── Deliveries ───────────────────────────────────────────────────────────────

model Delivery {
  id             String       @id @default(uuid())
  webhookEventId String       @map("webhook_event_id")
  webhookEvent   WebhookEvent @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)

  destinationUrl String         @map("destination_url")
  status         DeliveryStatus @default(PENDING)
  responseCode   Int?           @map("response_code")

  /// Response body moved to object storage — S3 URL stored here.
  /// Prevents this table from becoming a multi-GB text dump.
  responseBodyUrl String? @map("response_body_url")

  latencyMs  Int?    @map("latency_ms")
  retryCount Int     @default(0) @map("retry_count")
  isReplay   Boolean @default(false) @map("is_replay")

  /// Structured error code replaces the previous internalStatus String.
  errorCode DeliveryErrorCode? @map("error_code")

  /// Timestamp polled by the retry scheduler — replaces ad-hoc retryCount checks.
  nextRetryAt DateTime? @map("next_retry_at")

  // Some endpoint require manual acknowledgment to mark a delivery as successful (e.g. Stripe's event replay). This allows us to separate "pending retry" from "success but waiting for ack".
  ackedAt   DateTime?
  ackStatus String? // success | failed


  createdAt DateTime  @default(now()) @map("created_at")

  /// Optimistic locking — prevents concurrent workers from double-delivering.
  /// App layer: UPDATE ... SET status=X, version=N+1 WHERE id=Y AND version=N
  version Int @default(0)

  logs EventLog[]

  /// Retry scheduler query: PENDING/RETRYING rows due for next attempt
  @@index([status, nextRetryAt])
  /// Idempotency check: has this attempt count already been processed?
  @@index([webhookEventId, retryCount])
  /// Dashboard query: recent failures
  @@index([status, createdAt])
  @@map("deliveries")
}

// ─── Event Logs ───────────────────────────────────────────────────────────────

/// Append-only audit trail — one row per notable state change or delivery outcome.
/// For high-volume logging (>1M rows/day) consider offloading to ClickHouse/ELK;
/// keep this table for critical state only.
model EventLog {
  id             String       @id @default(uuid())
  webhookEventId String       @map("webhook_event_id")
  webhookEvent   WebhookEvent @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)

  /// Null when the entry describes the event itself, not a specific delivery.
  deliveryId String?   @map("delivery_id")
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  /// Bounded enum — prevents unbounded string values that break aggregation.
  status  LogStatus

  // type = action or outcome being logged — e.g. "EVENT_RECEIVED", "DELIVERY_SUCCESS", "SIGNATURE_VERIFIED". This allows filtering logs by type without scanning the message text.
  type LogType
  message String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([webhookEventId])
  @@index([deliveryId])
  /// Time-based pruning query: DELETE FROM event_logs WHERE created_at < cutoff
  @@index([createdAt])
  @@map("event_logs")
}

// ─── Usage Tracking ───────────────────────────────────────────────────────────

/// Aggregated monthly event counts per user.
/// Avoids expensive COUNT(*) on webhook_events for quota enforcement.
/// Pattern: increment on ingest, compare against plan.eventsPerMonth on request.
model Usage {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  /// Format: "2026-04" — monthly granularity aligns with billing periods.
  month      String
  eventCount Int      @default(0) @map("event_count")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, month])
  @@map("usage")
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

/// Static tier definitions — one row per plan, rarely mutated.
model Plan {
  id             String   @id @default(uuid())
  tier           PlanTier @unique
  eventsPerMonth Int      @map("events_per_month")
  retentionDays  Int      @map("retention_days")
  endpointLimit  Int      @map("endpoint_limit")
  /// Monthly price in cents (0 for FREE).
  priceCents     Int      @map("price_cents")
  createdAt      DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id])

  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")

  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  cancelAtPeriodEnd  Boolean  @default(false) @map("cancel_at_period_end")

  /// Timestamp of last successful Stripe status sync.
  /// Monitor this: if now() - lastSyncedAt > threshold, treat status as stale.
  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscriptions")
}
