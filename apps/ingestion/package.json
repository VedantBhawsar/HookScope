{
  "name": "@hookscope/ingestion",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "check:env": "bun ../../packages/env/scripts/check.ts ingestion --dotenv .env",
    "dev": "bun --watch index.ts",
    "build": "bun build ./index.ts --outdir ./dist --target bun",
    "start": "bun ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,js}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.835.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/sensible": "^6.0.3",
    "@hookscope/db": "workspace:*",
    "@hookscope/env": "workspace:*",
    "@hookscope/redis": "workspace:*",
    "@hookscope/s3": "workspace:*",
    "bullmq": "^5.0.0",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.1",
    "pino-pretty": "^13.1.3",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@hookscope/eslint-config": "workspace:*",
    "@hookscope/typescript-config": "workspace:*",
    "@types/bun": "^1.0.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
