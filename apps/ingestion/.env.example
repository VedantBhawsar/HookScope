# Generated by @hookscope/env — edit packages/env/src/docs.ts and re-run
# `bun run check:env generate` to update this file.

# ─── Server ───────────────────────────────────────────────
# Runtime environment
NODE_ENV=development
# Ingestion server port
PORT=5001
# Bind address
HOST=0.0.0.0
# Pino log level
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────
# Postgres connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhook_db

# ─── Redis ────────────────────────────────────────────────
# Redis connection string (used for queues + cache) (required)
REDIS_URL=redis://localhost:6379

# ─── S3 ───────────────────────────────────────────────────
# S3-compatible endpoint (MinIO/LocalStack) (required)
S3_ENDPOINT=http://localhost:4566
# Bucket for stored webhook payloads (required)
S3_BUCKET=webhooks
# AWS region (required)
AWS_REGION=us-east-1
# S3 access key (required)
AWS_ACCESS_KEY_ID=minioadmin
# S3 secret key (required)
AWS_SECRET_ACCESS_KEY=minioadmin
