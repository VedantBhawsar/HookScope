{
  "name": "@hookscope/api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "build": "bun build ./index.ts --outdir ./dist --target bun",
    "start": "bun ./dist/index.js",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@hookscope/db": "workspace:*",
    "@hookscope/redis": "workspace:*",
    "@hookscope/s3": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "jose": "^6.2.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "stripe": "^22.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@hookscope/eslint-config": "workspace:*",
    "@hookscope/typescript-config": "workspace:*",
    "@types/bun": "^1.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "eslint": "^9.39.2",
    "prisma": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "schema": "../../packages/db/prisma/schema.prisma"
  }
}
