# Generated by @hookscope/env — edit packages/env/src/docs.ts and re-run
# `bun run check:env generate` to update this file.

# ─── Server ───────────────────────────────────────────────
# Runtime environment
NODE_ENV=development
# API server port
PORT=5000

# ─── Database ─────────────────────────────────────────────
# Postgres connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhook_db

# ─── Redis ────────────────────────────────────────────────
# Redis connection string (required)
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────
# Secret used to sign access tokens (openssl rand -hex 32) (required)
JWT_ACCESS_SECRET=

# ─── Maintenance ──────────────────────────────────────────
# Secret for maintenance endpoints (openssl rand -hex 32) (required)
MAINTENANCE_SECRET=

# ─── URLs ─────────────────────────────────────────────────
# Public base URL of this API (used for OAuth callbacks) (required)
API_BASE_URL=http://localhost:5000
# Public URL of the web dashboard (CORS + redirects) (required)
FRONTEND_URL=http://localhost:3000
# Base URL of the ingestion server (required)
INGESTION_BASE_URL=http://localhost:5001
# Cookie domain for auth cookies (.yourdomain.com in prod, unset in dev)
COOKIE_DOMAIN=.yourdomain.com

# ─── App ──────────────────────────────────────────────────
# Brand name used in emails
APP_NAME=HookScope

# ─── OAuth — Google ───────────────────────────────────────
# Google OAuth client ID (empty disables Google sign-in)
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=

# ─── OAuth — GitHub ───────────────────────────────────────
# GitHub OAuth client ID (empty disables GitHub sign-in)
GITHUB_CLIENT_ID=Ov23liEXAMPLE
# GitHub OAuth client secret
GITHUB_CLIENT_SECRET=

# ─── Email (SMTP) ─────────────────────────────────────────
# SMTP host for transactional email
SMTP_HOST=smtp.ethereal.email
# SMTP port
SMTP_PORT=587
# Use TLS for SMTP (true/false)
SMTP_SECURE=false
# SMTP username
SMTP_USER=
# SMTP password
SMTP_PASS=
# From address for outgoing email
SMTP_FROM=noreply@hookscope.dev

# ─── Dodo Payments ────────────────────────────────────────
# Dodo Payments API key
DODO_PAYMENTS_API_KEY=
# Dodo Payments webhook signing key
DODO_PAYMENTS_WEBHOOK_KEY=
# Dodo product ID for Starter (monthly)
DODO_STARTER_MONTHLY_PRODUCT_ID=product_xxxxxxxxxxxxxxxx
# Dodo product ID for Starter (annual)
DODO_STARTER_ANNUAL_PRODUCT_ID=product_xxxxxxxxxxxxxxxx
# Dodo product ID for Pro (monthly)
DODO_PRO_MONTHLY_PRODUCT_ID=product_xxxxxxxxxxxxxxxx
# Dodo product ID for Pro (annual)
DODO_PRO_ANNUAL_PRODUCT_ID=product_xxxxxxxxxxxxxxxx
