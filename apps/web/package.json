{
  "name": "@hookscope/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "check:env": "bun ../../packages/env/scripts/check.ts web --dotenv .env",
    "dev": "bun ../../packages/env/scripts/check.ts web --dotenv .env && next dev --turbopack -p 3000",
    "build": "next build",
    "start": "bun ../../packages/env/scripts/check.ts web --dotenv .env && next start -p 3000",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@hookscope/ui": "workspace:*",
    "@tanstack/react-query": "^5.97.0",
    "axios": "^1.15.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.378.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "recharts": "3.8.0",
    "sonner": "^1.7.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@hookscope/eslint-config": "workspace:*",
    "@hookscope/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
