# ─── Build context ────────────────────────────────────────────────────────────
# These are excluded from the Docker build context to keep it small and fast.
# Only the files explicitly COPY'd in the Dockerfile are needed.

.git
.gitignore
.turbo
.agents
.npmrc
.prettierignore
.prettierrc

# App source we don't need in the ingestion image
apps/api
apps/web

# Package sources not consumed by ingestion
packages/db/src
packages/db/prisma
packages/db/generated
packages/ui/src

# Dev artefacts
node_modules
**/node_modules
**/.next
**/dist
**/coverage
**/*.log

# Env files (secrets should never enter the build context)
.env
.env.*
