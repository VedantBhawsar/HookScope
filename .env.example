# Copy this file to .env and adjust values as needed.
# When running infrastructure via docker-compose, the defaults below connect
# to the exposed host ports.

# ─── Postgres ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhook_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=super-secret-access-key-change-in-production

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MinIO (S3) ─────────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=webhooks
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ─── Ingestion server ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# ─── API server ───────────────────────────────────────────────────────────────
# URL the browser redirects back to after OAuth — must match the callback URL
# registered in Google Console / GitHub OAuth App settings.
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ─── OAuth — Google ───────────────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:5000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth — GitHub ───────────────────────────────────────────────────────────
# Settings → Developer Settings → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:5000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Email (password reset) ───────────────────────────────────────────────────
# Local dev: create a free Ethereal test account at https://ethereal.email
# The backend logs a preview URL on every send when NODE_ENV != production.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@openwolf.dev
APP_NAME=HookScope

# ─── Stripe (Billing & Subscriptions) ──────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret for Stripe event verification
# Get from: https://dashboard.stripe.com/webhooks (create endpoint for your URL)
STRIPE_WEBHOOK_SECRET=whsec_test_...

# ─── Stripe Price IDs (from created products) ──────────────────────────────────
# Developer Plan Prices
STRIPE_DEVELOPER_MONTHLY_PRICE_ID=price_1TO8hfSAEf83EM9SeLSJ8GOH
STRIPE_DEVELOPER_ANNUAL_PRICE_ID=price_1TO8hgSAEf83EM9S71hGRf6b

# Pro Plan Prices
STRIPE_PRO_MONTHLY_PRICE_ID=price_1TO8hiSAEf83EM9Sq7tynleM
STRIPE_PRO_ANNUAL_PRICE_ID=price_1TO8hjSAEf83EM9ShixrfEKI

# Enterprise Plan Prices
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_1TO8hkSAEf83EM9SrhPAIpH4
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_1TO8hlSAEf83EM9SxMeegkUr
